{
    "name": "domain-reseller/app",
    "description": "Domain Reselling Platform - Custom PHP Application",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.5",
        "phpmailer/phpmailer": "^6.8",
        "stripe/stripe-php": "^12.0",
        "dompdf/dompdf": "^2.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Helpers/functions.php"
        ]
    },
    "scripts": {
        "start": "php -S localhost:8000 -t public"
    }
}
